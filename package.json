{
  "name": "cpin-ines-s3",
  "version": "0.1.0",
  "private": true,
  "description": "POC transferring files between two S3 storages through INES",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --use-env-proxy --watch --import tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env --use-env-proxy dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
